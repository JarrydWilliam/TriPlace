# SameVibe / TriPlace Environment Configuration Example
# Copy this file to .env and insert your real credentials.

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

DATABASE_URL=postgresql://user:password@localhost:5432/samevibe

VITE_APP_VERSION=1.1.1
EVENTBRITE_API_KEY=your_eventbrite_api_key
TICKETMASTER_API_KEY=your_ticketmaster_api_key
PREDICTHQ_API_KEY=your_predicthq_api_key
SEATGEEK_CLIENT_ID=your_seatgeek_client_id

NODE_ENV=development
PORT=5000
