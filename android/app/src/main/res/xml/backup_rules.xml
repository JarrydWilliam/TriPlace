<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for SameVibe (Android 12+ / API 31+).
    android:dataExtractionRules references this file.

    Per Google Play policy and GDPR best practice, we exclude all user PII
    from Android Auto-Backup to prevent sensitive data (auth tokens, profile
    data, location) from being stored in Google Drive backups.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
